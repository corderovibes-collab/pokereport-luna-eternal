@@ -0,0 +1,160 @@
+package com.cobblemon.vocalized.common.client.controller.party
+
+import com.cobblemon.mod.common.CobblemonNetwork
+import com.cobblemon.mod.common.client.CobblemonClient
+import com.cobblemon.mod.common.net.messages.server.SendOutPokemonPacket
+import com.cobblemon.mod.common.pokemon.activestate.SentOutState
+import com.cobblemon.vocalized.api.voice.VoiceController
+import com.cobblemon.vocalized.api.voice.VoicePipeline
+import com.cobblemon.vocalized.common.client.VocalizedCommonClient
+import com.cobblemon.vocalized.common.client.VocalizedVoice
+import com.cobblemon.vocalized.common.voice.VocalizedPhrases
+import com.cobblemon.vocalized.common.voice.pipeline.VocalizedVoicePipeline
+import java.util.Locale
+
+/**
+ * Control del equipo por voz fuera del combate: sacar, guardar y cambiar de Pokemon.
+ *
+ * Los tres comandos viven en un unico controlador a proposito. [VoiceController] abre una captura
+ * de microfono independiente por cada controlador activo, asi que repartirlos en varios provocaria
+ * varias capturas simultaneas del mismo dispositivo.
+ *
+ * Sustituye al antiguo `RecallVoiceController`, que solo se activaba cuando el Pokemon ya estaba
+ * fuera y por tanto nunca podia sacarlo.
+ */
+class PartyVoiceController : VoiceController({ null }) {
+
+	private val pipelineFactory: VocalizedVoicePipeline = VocalizedVoice.pipeline()
+
+	/** Estado con el que se construyo la lista de frases activa. */
+	private var signature: String = ""
+
+	/** Accion asociada a cada frase reconocida. */
+	private sealed interface Command {
+		data object SendOut : Command
+
+		data object Recall : Command
+
+		data class SwitchTo(val slot: Int) : Command
+	}
+
+	override fun isActive(): Boolean {
+		if (CobblemonClient.battle != null) return false
+		if (!VocalizedCommonClient.isSpeaking()) return false
+		if (CobblemonClient.storage.party.isEmpty()) return false
+
+		// Si el equipo cambio (capturas, relevos, cambio de ranura) la lista de frases se quedo
+		// vieja. Parar aqui obliga a que el siguiente tick reconstruya la tuberia con la nueva.
+		val current = currentSignature()
+		if (current != signature) {
+			signature = current
+			stop()
+		}
+
+		return true
+	}
+
+	private fun currentSignature(): String {
+		val storage = CobblemonClient.storage
+		return storage.party.slots.joinToString(",") { it?.uuid?.toString() ?: "-" } +
+			"|" + storage.selectedSlot
+	}
+
+	override fun buildPipeline(): VoicePipeline? {
+		val commands = buildCommands()
+		if (commands.isEmpty()) return null
+
+		return pipelineFactory.createSubstringMatchPipeline(
+			commands.keys.toList(),
+			{ matched -> commands[matched.trim().lowercase(Locale.ROOT)]?.let(::execute) },
+			false,
+		)
+	}
+
+	/**
+	 * Construye el mapa frase -> accion.
+	 *
+	 * Sacar y guardar se registran **siempre las dos**, aunque en este instante solo una tenga
+	 * sentido, y es [execute] quien decide mirando el estado del momento. Registrar solo la que
+	 * toca provocaba un bloqueo: al sacar al Pokemon la tuberia se reconstruye de inmediato, antes
+	 * de que el servidor confirme el cambio, asi que volvia a registrar "sacar" y nunca "guardar";
+	 * y sin una frase que pueda acertar, ya no habia nada que disparase otra reconstruccion.
+	 *
+	 * Los nombres del equipo se anaden despues de los verbos genericos para que, ante una colision
+	 * (por ejemplo un Pokemon apodado "Ve"), gane el nombre concreto sobre el verbo.
+	 */
+	private fun buildCommands(): Map<String, Command> {
+		val commands = LinkedHashMap<String, Command>()
+
+		for (phrase in VocalizedPhrases.of(VocalizedPhrases.SEND_OUT)) {
+			commands[phrase] = Command.SendOut
+		}
+		for (phrase in VocalizedPhrases.of(VocalizedPhrases.RECALL)) {
+			commands[phrase] = Command.Recall
+		}
+
+		val party = CobblemonClient.storage.party
+		val switchPrefixes = VocalizedPhrases.of(VocalizedPhrases.SWITCH)
+
+		for (slot in party.slots.indices) {
+			val pokemon = party.get(slot) ?: continue
+			if (pokemon.isFainted()) continue
+
+			val name = pokemon.getDisplayName(false).string.trim().lowercase(Locale.ROOT)
+			if (name.isEmpty()) continue
+
+			commands[name] = Command.SwitchTo(slot)
+			for (prefix in switchPrefixes) {
+				commands["$prefix $name"] = Command.SwitchTo(slot)
+			}
+		}
+
+		return commands
+	}
+
+	private fun isSelectedSentOut(): Boolean {
+		val storage = CobblemonClient.storage
+		val pokemon = storage.party.get(storage.selectedSlot) ?: return false
+		return pokemon.state is SentOutState
+	}
+
+	private fun execute(pCommand: Command) {
+		if (CobblemonClient.battle != null) return
+
+		when (pCommand) {
+			is Command.SendOut -> if (!isSelectedSentOut()) toggle(CobblemonClient.storage.selectedSlot)
+			is Command.Recall -> if (isSelectedSentOut()) toggle(CobblemonClient.storage.selectedSlot)
+			is Command.SwitchTo -> switchTo(pCommand.slot)
+		}
+	}
+
+	/**
+	 * Cambia de Pokemon activo.
+	 *
+	 * `SendOutPokemonPacket` alterna, asi que primero se guarda el que estuviese fuera y solo
+	 * despues se saca el nuevo; enviar el segundo paquete sin recoger el primero dejaria al
+	 * servidor decidiendo entre dos Pokemon fuera a la vez.
+	 */
+	private fun switchTo(pSlot: Int) {
+		val storage = CobblemonClient.storage
+		val target = storage.party.get(pSlot) ?: return
+		if (target.isFainted()) return
+
+		if (pSlot == storage.selectedSlot && target.state is SentOutState) return
+
+		if (isSelectedSentOut()) toggle(storage.selectedSlot)
+
+		storage.selectedSlot = pSlot
+		toggle(pSlot)
+	}
+
+	private fun toggle(pSlot: Int) {
+		CobblemonNetwork.sendToServer(SendOutPokemonPacket(pSlot))
+	}
+
+	override fun getPhrases(): List<String> = buildCommands().keys.toList()
+
+	override fun getId(): String = "PartyVoiceController"
+
+	override fun threadName(): String = "Cobblemon-PartyVoicePipeline"
+}
