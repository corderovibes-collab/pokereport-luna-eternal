+package com.cobblemon.vocalized.common.internal
+
+import com.cobblemon.vocalized.common.Vocalized
+import com.google.gson.JsonParser
+import net.minecraft.resources.ResourceLocation
+import net.minecraft.server.packs.resources.ResourceManager
+import java.io.InputStreamReader
+import java.nio.charset.StandardCharsets
+
+/**
+ * Textos leidos en el idioma del modelo de voz, no en el de la interfaz.
+ *
+ * Es una distincion que importa mucho. Los nombres de los movimientos y las frases de activacion
+ * se resolvian con el idioma del cliente, pero el modelo de reconocimiento siempre es el mismo:
+ * un jugador con el juego en ingles acababa escuchando espanol y comparandolo contra "Hydro Pump"
+ * e "i choose you". No acertaba nada, y no habia forma de notarlo salvo probando.
+ *
+ * Leyendo aqui el fichero de idioma que corresponde al modelo cargado, el mod funciona igual sin
+ * importar en que idioma tenga cada jugador su juego.
+ */
+object VocalizedLangTable {
+
+	private val entries = HashMap<String, String>()
+
+	fun reload(pResourceManager: ResourceManager, pLanguage: String, pNamespaces: List<String>) {
+		entries.clear()
+
+		for (namespace in pNamespaces) {
+			val location = ResourceLocation.fromNamespaceAndPath(namespace, "lang/$pLanguage.json")
+			try {
+				pResourceManager.getResource(location).ifPresent { resource ->
+					resource.open().use { stream ->
+						val json = JsonParser
+							.parseReader(InputStreamReader(stream, StandardCharsets.UTF_8))
+							.asJsonObject
+
+						for ((key, value) in json.entrySet()) {
+							if (value.isJsonPrimitive) entries[key] = value.asString
+						}
+					}
+				}
+			} catch (pThrowable: Throwable) {
+				Vocalized.LOGGER.warn("[Voice] Could not read {} language file:", namespace, pThrowable)
+			}
+		}
+
+		Vocalized.LOGGER.info("[Voice] Loaded {} '{}' translations for voice matching", entries.size, pLanguage)
+	}
+
+	fun get(pKey: String): String? = entries[pKey]
+}
