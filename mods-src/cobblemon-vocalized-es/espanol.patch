+	/**
+	 * Crea el reconocedor, restringido a [pGrammar] cuando se aporta una lista de frases.
+	 *
+	 * Limitar el vocabulario a lo que el jugador puede decir en ese instante (sus movimientos, su
+	 * equipo y las ordenes) sube mucho el acierto frente a dictado libre, sobre todo con el modelo
+	 * pequeno. Se anade `[unk]` para que el reconocedor pueda declarar "no era ninguna" en vez de
+	 * verse forzado a elegir la frase menos mala.
+	 *
+	 * Si el modelo no admite gramatica dinamica se vuelve al reconocedor normal: es preferible
+	 * escuchar con menos precision que quedarse sordo.
+	 */
+	private fun createRecognizer(pModel: Model, pSampleRate: Float, pGrammar: List<String>?): Recognizer {
+		val grammar = buildGrammarJson(pGrammar)
+		if (grammar != null) {
+			try {
+				val restricted = Recognizer(pModel, pSampleRate, grammar)
+				if (restricted.pointer != null) {
+					Vocalized.LOGGER.info("[Voice] Recognizer restricted to {} phrase(s)", pGrammar?.size ?: 0)
+					return restricted
+				}
+				Vocalized.LOGGER.warn("[Voice] Model rejected the restricted grammar; falling back to free speech")
+			} catch (pThrowable: Throwable) {
+				Vocalized.LOGGER.warn("[Voice] Could not build a restricted grammar; falling back:", pThrowable)
+			}
+		}
+
+		return Recognizer(pModel, pSampleRate)
+	}
+
+	private fun buildGrammarJson(pGrammar: List<String>?): String? {
+		if (pGrammar.isNullOrEmpty()) return null
+
+		val entries = pGrammar
+			.asSequence()
+			.map { Vocalized.NON_ALPHANUM_SPACE.matcher(it.lowercase()).replaceAll(" ") }
+			.map { Vocalized.MULTI_SPACE.matcher(it).replaceAll(" ").trim() }
+			.filter { it.isNotEmpty() }
+			.distinct()
+			.toList()
+
+		if (entries.isEmpty()) return null
+
+		return (entries + "[unk]").joinToString(
+			separator = ",",
+			prefix = "[",
+			postfix = "]",
+		) { "\"" + it.replace("\\", "\\\\").replace("\"", "\\\"") + "\"" }
+	}
