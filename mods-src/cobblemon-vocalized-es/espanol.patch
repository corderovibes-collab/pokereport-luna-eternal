+package com.cobblemon.vocalized.common.vosk
+
+import com.sun.jna.Memory
+import com.sun.jna.Pointer
+
+/**
+ * Conversion de cadenas con la libreria nativa, siempre en UTF-8.
+ *
+ * Vosk habla UTF-8, pero [com.sun.jna.Native.register] usa el juego de caracteres por defecto de
+ * la plataforma, que en un Windows en espanol es Cp1252. Dejarlo asi tenia dos consecuencias, y
+ * ninguna avisaba:
+ *
+ * - Al leer, cualquier palabra con tilde volvia rota: "si" se recibia como "sÃ­", de modo que
+ *   ordenes como "ven aqui" o "garra dragon" no podian coincidir jamas.
+ * - Al escribir, la ruta del modelo viaja como cadena. Un jugador cuyo usuario de Windows lleve
+ *   tilde o enye ("Jose", "Munoz") generaba una ruta que la libreria no sabia abrir, y el modelo
+ *   fallaba al cargar sin mas explicacion.
+ */
+object VoskStrings {
+
+	fun toNative(pValue: String): Memory {
+		val bytes = pValue.toByteArray(Charsets.UTF_8)
+		val memory = Memory((bytes.size + 1).toLong())
+		memory.write(0, bytes, 0, bytes.size)
+		memory.setByte(bytes.size.toLong(), 0)
+		return memory
+	}
+
+	fun fromNative(pPointer: Pointer?): String? = pPointer?.getString(0, Charsets.UTF_8.name())
+}
