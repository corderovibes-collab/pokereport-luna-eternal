+package com.cobblemon.vocalized.common.voice
+
+import com.cobblemon.vocalized.common.Vocalized
+import com.cobblemon.vocalized.common.internal.VocalizedLang
+import com.cobblemon.vocalized.common.internal.VocalizedLangTable
+import java.util.Locale
+
+/**
+ * Frases de activacion traducibles.
+ *
+ * Cada clave de idioma agrupa varias alternativas separadas por `|`, de modo que cada traduccion
+ * aporta los sinonimos naturales de su lengua sin tocar el codigo. En espanol conviene ofrecer
+ * varias formas porque el reconocedor puede oir cualquiera de ellas:
+ *
+ * ```
+ * "voice.cobblemon_vocalized.phrase.send_out": "adelante|yo te elijo|sal|ve"
+ * ```
+ *
+ * Si la clave no esta traducida se devuelve una lista vacia y el comando simplemente no se ofrece,
+ * en lugar de registrar la clave cruda como si fuese una frase.
+ */
+object VocalizedPhrases {
+
+	/** Sacar al Pokemon seleccionado. */
+	const val SEND_OUT: String = "phrase.send_out"
+
+	/** Guardar al Pokemon que esta fuera. */
+	const val RECALL: String = "phrase.recall"
+
+	/** Prefijos de cambio ("cambia a ...") usados dentro y fuera del combate. */
+	const val SWITCH: String = "phrase.switch"
+
+	/** Rendirse en combate. */
+	const val FORFEIT: String = "phrase.forfeit"
+
+	fun of(pKey: String): List<String> {
+		// Primero el idioma del modelo de voz; el de la interfaz solo como respaldo. Un jugador
+		// con el juego en ingles debe seguir diciendo las frases en el idioma que el mod escucha.
+		val raw = VocalizedLangTable.get("voice.${Vocalized.MOD_ID}.$pKey")
+			?: VocalizedLang.voice(pKey).string
+
+		if (raw.isBlank() || raw.endsWith(pKey)) return emptyList()
+
+		return raw.split('|')
+			.map { it.trim().lowercase(Locale.ROOT) }
+			.filter { it.isNotEmpty() }
+			.distinct()
+	}
+}
